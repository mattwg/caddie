{
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "mkdir -p \"$HOME/.caddie/state\"; CADDIE_BIN=$(command -v caddie || echo \"$HOME/.local/bin/caddie\"); \"$CADDIE_BIN\" track-observe >>\"$HOME/.caddie/state/hooks.log\" 2>&1"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "mkdir -p \"$HOME/.caddie/state\"; CADDIE_BIN=$(command -v caddie || echo \"$HOME/.local/bin/caddie\"); \"$CADDIE_BIN\" track-update >>\"$HOME/.caddie/state/hooks.log\" 2>&1"
        }
      ]
    }
  ]
}
